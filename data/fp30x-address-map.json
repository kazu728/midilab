    ]
  },
  "params": [
    {
      "name": "connection",
      "write_address": "01 00 03 06",
      "size": 1,
      "encoding": "u7",
      "enum": { "1": "open" },
      "source": "app_re",
      "source_ref": "Roland Piano App 1.5.9 RE, via aortegaCampanillas/RolandFP30xController@4492773",
      "verified": [],
      "notes": "Handshake the app sends right after connecting; without it some writes are reportedly ignored. Measured on 2026-08-08: writes are applied without ever sending this, so it is not a precondition. It stays unverified because it has no read address — pianoctl can send it but can never confirm it landed."
    },
    {
      "name": "metronome_status",
      "read_address": "01 00 01 0F",
      "size": 1,
      "encoding": "u7",
      "enum": { "0": "off", "1": "on" },
      "source": "app_re",
      "source_ref": "Roland Piano App 1.5.9 RE, via aortegaCampanillas/RolandFP30xController@4492773",
      "verified": [
        { "firmware": "1C 01 00 00", "date": "2026-08-08", "method": "rq1_roundtrip" }
      ],
      "notes": "The panel was reported to emit this address unprompted; measured on 2026-08-08 it does not. Toggling the metronome by hand produced no SysEx at all, so this address can only be reached by asking for it."
    },
    {
      "name": "metronome_switch",
      "write_address": "01 00 03 1A",
      "size": 1,
      "encoding": "u7",
      "enum": { "0": "off", "1": "on", "2": "on_request_next_start" },
      "verify_with": "metronome_status",
      "source": "app_re",
      "source_ref": "Roland Piano App 1.5.9 RE, via aortegaCampanillas/RolandFP30xController@4492773",
      "verified": [
        { "firmware": "1C 01 00 00", "date": "2026-08-08", "method": "write_readback" }
      ],
      "notes": "Write-only counterpart of metronome_status. on_request_next_start has no name on the read side, so it can never be shown as already applied."
    },
    {
      "name": "sequencer_tempo",
      "read_address": "01 00 01 08",
      "write_address": "01 00 03 09",
      "size": 2,
      "encoding": "u14",
      "range": { "min": 10, "max": 500 },
      "source": "app_re",
      "source_ref": "Roland Piano App 1.5.9 RE, via aortegaCampanillas/RolandFP30xController@4492773",
      "verified": [
        { "firmware": "1C 01 00 00", "date": "2026-08-08", "method": "rq1_roundtrip" },
        { "firmware": "1C 01 00 00", "date": "2026-08-08", "method": "write_readback" }
      ],
      "notes": "Read and write addresses differ, which is why the map holds a pair rather than one address per parameter."
    },
